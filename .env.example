# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Configuration for sending live emails to xanab2105@gmail.com
# Only used if you deploy the Node/Express backend (server.ts) yourself.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=true

# EmailJS Configuration — this is what the Contact form actually uses now.
# It sends email directly from the browser, so it works on ANY static host
# (no backend required). Create a free account at https://www.emailjs.com,
# connect your Gmail as an "Email Service", create an Email Template with
# {{from_name}}, {{from_email}}, {{subject}}, {{message}} variables, then
# fill in these three values from your EmailJS dashboard. These are safe
# to expose in the frontend build (that's how EmailJS is designed to work).
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Guestbook admin password — only used server-side (server.ts).
# This is checked in a backend API route and is NEVER sent to the
# browser or included in any frontend JS bundle. Only the Node/Express
# server (server.ts) needs this — it does not work on a purely static
# host (Netlify/Vercel static export) since there's no server to check it.
# Set this to whatever you want your real posting password to be.
GUESTBOOK_ADMIN_PASSWORD=changeme123
